---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LATEST_RELEASE_URL } from '../../lib/kate-releases.mjs';
---

<BaseLayout
  title="Download Kate"
  description="Download the latest version of Kate, an AI coaching agent for senior executives."
>
  <div class="mx-auto max-w-6xl px-6 py-16 md:px-10 md:py-24">
    <a
      href="/projects/kate"
      class="mb-12 inline-flex items-center text-xs font-bold text-ink-muted transition-colors duration-150 hover:text-ink"
    >
      &larr; Back to Kate
    </a>

    <header class="mb-12 max-w-xl">
      <h1 class="mb-4 font-display text-5xl font-semibold leading-none text-ink md:text-7xl">
        Download Kate
      </h1>
      <p class="text-lg leading-relaxed text-ink-muted">
        Get the latest release and start using Kate to accelerate your job search.
      </p>
    </header>

    <div class="mb-12 rounded-[8px] border border-border bg-surface p-8 md:p-12">
      <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
        <div>
          <div class="mb-2 flex items-center gap-3">
            <h2 class="font-display text-3xl font-semibold text-ink" data-kate-release-name>
              Latest Kate release
            </h2>
            <span class="rounded-full border border-gold/60 bg-gold-light px-3 py-1 text-xs font-bold text-accent">
              Latest
            </span>
          </div>
          <p class="text-sm text-ink-muted" data-kate-release-date>
            Release details load directly from GitHub.
          </p>
        </div>
        <a
          href={LATEST_RELEASE_URL}
          class="inline-flex min-h-12 shrink-0 items-center rounded-[6px] border border-accent bg-accent px-5 text-sm font-bold text-surface transition-colors duration-150 hover:bg-accent-dark"
          data-kate-download-url
        >
          <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span data-kate-download-label>View Latest Release</span>
        </a>
      </div>
      <p class="mt-4 hidden text-sm text-ink-muted" data-kate-release-error>
        Release details could not be refreshed. The button still opens the latest release on GitHub.
      </p>
    </div>

    <section class="mb-12">
      <h2 class="mb-4 font-display text-3xl font-semibold text-ink">Getting Started</h2>
      <div class="rounded-[8px] border border-border bg-surface p-6">
        <p class="mb-4 text-ink-muted">
          Download our getting started guide to learn how to set up and use Kate effectively.
        </p>
        <a
          href="/kate-getting-started-v5.docx"
          class="inline-flex min-h-11 items-center rounded-[6px] border border-border bg-surface px-5 text-sm font-bold text-ink transition-colors duration-150 hover:bg-soft"
          download
        >
          <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Download Getting Started Guide (v5)
        </a>
        <p class="mt-3 text-xs text-ink-muted">
          Microsoft Word document (.docx) - compatible with Word, Google Docs, and other word processors.
        </p>
      </div>
    </section>

    <section class="hidden" data-kate-changelog>
      <h2 class="mb-6 font-display text-3xl font-semibold text-ink">Changelog</h2>
      <div class="space-y-8" data-kate-changelog-list></div>
    </section>
  </div>
</BaseLayout>

<script>
  import {
    RELEASES_API_URL,
    findZipAsset,
    formatReleaseDate,
    renderReleaseMarkdown,
    selectLatestStableRelease,
  } from '../../lib/kate-releases.mjs';

  const releaseName = document.querySelector('[data-kate-release-name]');
  const releaseDate = document.querySelector('[data-kate-release-date]');
  const downloadLink = document.querySelector('[data-kate-download-url]');
  const downloadLabel = document.querySelector('[data-kate-download-label]');
  const releaseError = document.querySelector('[data-kate-release-error]');
  const changelog = document.querySelector('[data-kate-changelog]');
  const changelogList = document.querySelector('[data-kate-changelog-list]');

  function renderChangelog(releases) {
    if (!changelog || !changelogList) return;

    const fragment = document.createDocumentFragment();

    for (const release of releases.slice(0, 5)) {
      const entry = document.createElement('div');
      entry.className = 'border-b border-border pb-8 last:border-0';

      const heading = document.createElement('div');
      heading.className = 'mb-3 flex items-baseline justify-between';

      const title = document.createElement('h3');
      title.className = 'font-display text-2xl font-semibold text-ink';
      title.textContent = release.name || release.tag_name;

      const date = document.createElement('time');
      date.className = 'text-sm text-ink-muted';
      date.dateTime = release.published_at;
      date.textContent = formatReleaseDate(release.published_at);

      heading.append(title, date);
      entry.append(heading);

      if (release.body) {
        const notes = document.createElement('div');
        notes.className = 'text-sm leading-relaxed text-ink-muted';
        notes.innerHTML = renderReleaseMarkdown(release.body);
        entry.append(notes);
      }

      fragment.append(entry);
    }

    changelogList.replaceChildren(fragment);
    changelog.classList.remove('hidden');
  }

  async function refreshReleaseDetails() {
    try {
      const response = await fetch(RELEASES_API_URL, {
        headers: { Accept: 'application/vnd.github+json' },
      });

      if (!response.ok) {
        throw new Error(`GitHub API responded with ${response.status}`);
      }

      const releases = await response.json();
      const latestRelease = selectLatestStableRelease(releases);

      if (!latestRelease) {
        throw new Error('GitHub returned no stable Kate releases');
      }

      if (releaseName) {
        releaseName.textContent = latestRelease.name || latestRelease.tag_name;
      }
      if (releaseDate) {
        releaseDate.textContent = `Released ${formatReleaseDate(latestRelease.published_at)}`;
      }

      const zipAsset = findZipAsset(latestRelease);
      if (zipAsset && downloadLink && downloadLabel) {
        downloadLink.setAttribute('href', zipAsset.browser_download_url);
        downloadLabel.textContent = 'Download .zip';
      }

      renderChangelog(releases.filter((release) => !release.draft && !release.prerelease));
    } catch (error) {
      releaseError?.classList.remove('hidden');
      console.error('Failed to fetch GitHub releases:', error);
    }
  }

  refreshReleaseDetails();
</script>
